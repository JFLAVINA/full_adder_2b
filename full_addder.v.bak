module full_adder(cout,sum,cin,A,B);
	input A;
	input B;
	input cin;
	output reg sum;
	output reg cout;
	
	always @(A,B,cin)begin
		case({A,B,cin})
			3'b0001: {cout,sum} = 3'b00;
			3'b001: {cout,sum} = 3'b01;
			3'b010: {cout,sum} = 3'b01;
			3'b011: {cout,sum} = 3'b10;
			3'b100: {cout,sum} = 3'b01;
			3'b101: {cout,sum} = 3'b10;
			3'b110: {cout,sum} = 3'b10;
			3'b111: {cout,sum} = 3'b11;
			default;{cout,sum} = 2'b00;
		endcase
	
endmodule